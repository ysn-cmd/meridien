# Alerting e-postası için SMTP ayarları.
# BOŞ bırakılırsa Ethereal test hesabı kullanılır: gerçek e-posta gitmez,
# konsola bir önizleme linki yazılır (test için ideal).

# Gerçek e-posta için doldur (ör. Gmail: SMTP_HOST=smtp.gmail.com, PORT=587,
# USER=adresin, PASS=uygulama-şifresi):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

ALERT_FROM=meridien@localhost
ALERT_TO=you@example.com

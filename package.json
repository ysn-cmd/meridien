{
  "name": "meridien",
  "version": "1.0.0",
  "description": "Plugin based automatic security scan and report platform (recon + DAST + SAST)",
  "type": "commonjs",
  "bin": {
    "meridien": "bin/scan.js"
  },
  "scripts": {
    "scan": "node bin/scan.js",
    "serve": "node src/api/server.js",
    "schedule": "node src/scheduler/index.js",
    "dashboard": "npm --prefix frontend run dev",
    "build-dashboard": "npm --prefix frontend run build",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "puppeteer": "^25.3.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "license": "MIT",
  "author": "ysn-cmd",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ysn-cmd/meridien.git"
  },
  "keywords": [
    "security",
    "scanner",
    "sast",
    "dast",
    "recon",
